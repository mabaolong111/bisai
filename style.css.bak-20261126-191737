:root {
  --bg: #f7f5ef;
  --surface: #ffffff;
  --surface-soft: #f1f8f4;
  --ink: #173238;
  --muted: #425959;
  --line: #d8e2dc;
  --accent: #0d5b50;
  --accent-dark: #08483f;
  --on-accent: #ffffff;
  --mint: #dbeee7;
  --warm: #fff3d8;
  --warm-ink: #6f4c12;
  --danger: #a23b2b;
  --danger-bg: #fff0eb;
  --focus: #b16700;
  --shadow: 0 14px 34px rgba(22, 56, 52, .09);
  --font-scale: 1;
}
* { box-sizing: border-box; }
html { font-size: calc(20px * var(--font-scale)); scroll-behavior: smooth; }
html[data-role="community"] { font-size: calc(16px * var(--font-scale)); }
body { margin: 0; max-width: 100%; overflow-x: hidden; background: var(--bg); color: var(--ink); font-family: "Microsoft YaHei", "Noto Sans SC", system-ui, sans-serif; font-size: 1rem; line-height: 1.6; letter-spacing: .01em; }
button, input, select, textarea { font: inherit; }
button { min-width: 60px; min-height: 60px; padding: 8px 14px; color: inherit; border: 0; cursor: pointer; }
button:disabled { opacity: .55; cursor: not-allowed; }
button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, summary:focus-visible { outline: 4px solid var(--focus); outline-offset: 3px; }
a { color: var(--accent); overflow-wrap: anywhere; }
img, canvas { max-width: 100%; }
[hidden] { display: none !important; }
h1, h2, h3, h4 { line-height: 1.35; overflow-wrap: anywhere; }
h1, h2 { font-size: 1.2rem; }
h3 { font-size: 1.05rem; }
p { overflow-wrap: anywhere; }
.skip-link { position: fixed; z-index: 100; left: 12px; top: -100px; padding: 12px; background: var(--surface); }
.skip-link:focus { top: 12px; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
.app-shell { min-height: 100vh; }
.demo-banner { padding: 10px 20px; color: var(--warm-ink); background: var(--warm); border-bottom: 1px solid var(--line); text-align: center; font-size: .85rem; font-weight: 800; }
.topbar { min-height: 92px; padding: 12px clamp(16px, 4vw, 64px); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; background: var(--surface); border-bottom: 1px solid var(--line); }
.brand-lockup, .role-intro, .location-pill, .hero-actions, .panel-heading, .section-heading, .button-row, .speech-controls, .family-actions { display: flex; align-items: center; flex-wrap: wrap; }
.brand-lockup { gap: 12px; }
.brand-mark { width: 48px; height: 48px; display: grid; place-items: center; flex: none; border-radius: 14px; color: var(--on-accent); background: var(--accent); font-size: 1.2rem; font-weight: 900; box-shadow: var(--shadow); }
.brand-name { font-size: 1.2rem; font-weight: 900; letter-spacing: .08em; }
.brand-subtitle { color: var(--muted); font-size: .7rem; }
.display-controls, .control-group { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }
.control-group { padding: 4px; border-radius: 12px; background: var(--surface-soft); }
.accessibility-control { min-height: 60px; color: var(--ink); background: transparent; border: 1px solid transparent; border-radius: 9px; font-size: .8rem; font-weight: 800; }
.accessibility-control.active { color: var(--on-accent); background: var(--accent); }
#main-content { width: min(1280px, calc(100% - 40px)); margin: 0 auto; padding: 34px 0 70px; }
.hero-section { position: relative; min-height: 290px; padding: clamp(26px, 4vw, 48px); overflow: hidden; border-radius: 26px; background: #dff0e9; }
.hero-copy { position: relative; z-index: 1; max-width: 700px; }
.eyebrow, .section-kicker { color: #376e63; font-size: .78rem; font-weight: 900; letter-spacing: .08em; }
.hero-copy h1 { margin: 10px 0; font-size: 1.2rem; }
.hero-copy p { max-width: 610px; margin: 0; color: #355c58; }
.hero-actions { gap: 10px; margin-top: 22px; }
.primary-button, .secondary-button { display: inline-flex; align-items: center; justify-content: center; min-height: 60px; padding: 10px 22px; border-radius: 13px; font-size: 1.1rem; font-weight: 900; }
.primary-button { color: var(--on-accent); background: var(--accent); box-shadow: 0 8px 18px rgba(13, 91, 80, .16); }
.primary-button:hover:not(:disabled) { background: var(--accent-dark); }
.secondary-button { color: var(--accent); background: var(--surface); border: 1px solid #a9c9bd; }
.logout-button { color: var(--danger); background: var(--danger-bg); border-color: var(--danger); }
.logout-button:hover:not(:disabled) { color: var(--on-accent); background: var(--danger); }
.text-button { color: var(--accent); background: transparent; font-weight: 900; }
.small-button, .icon-button { display: inline-flex; align-items: center; justify-content: center; min-height: 60px; color: var(--accent); background: var(--surface); border: 1px solid var(--line); border-radius: 10px; font-weight: 800; }
.danger-button { color: var(--danger); background: var(--danger-bg); border: 1px solid var(--danger); border-radius: 10px; font-weight: 800; }
.speech-controls { gap: 7px; margin-top: 12px; }
.speech-controls button, .speech-controls select { min-height: 60px; color: var(--accent); background: var(--surface); border: 1px solid #a9c9bd; border-radius: 9px; font-size: .85rem; font-weight: 800; }
.speech-controls label { display: flex; align-items: center; gap: 6px; }
.hero-illustration { position: absolute; inset: 0 0 0 60%; overflow: hidden; }
.sun-disc { position: absolute; width: 170px; height: 170px; top: 24px; right: 14%; border-radius: 50%; background: #f8d891; }
.hill { position: absolute; bottom: -125px; border-radius: 50% 50% 0 0; }
.hill-one { width: 560px; height: 250px; right: -90px; background: #a5d2c0; transform: rotate(-7deg); }
.hill-two { width: 430px; height: 180px; right: 170px; bottom: -100px; background: #76b5a0; transform: rotate(9deg); }
.house-card { position: absolute; z-index: 2; right: 20%; bottom: 42px; width: 126px; }
.house-roof { width: 0; height: 0; margin: auto; border-left: 68px solid transparent; border-right: 68px solid transparent; border-bottom: 65px solid #d77f61; }
.house-body { position: relative; width: 105px; height: 90px; margin: -2px auto 0; background: #fff8ed; }
.house-body span { display: inline-block; width: 23px; height: 25px; margin: 22px 7px 0 8px; background: #8cc8b7; border: 4px solid #fff; }
.house-body i { position: absolute; left: 40px; bottom: 0; width: 25px; height: 47px; border-radius: 13px 13px 0 0; background: #c98260; }
.role-strip { min-height: 82px; margin: 20px 0 30px; padding: 12px 4px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; border-bottom: 1px solid var(--line); }
.role-intro { gap: 12px; }
.role-label { color: var(--muted); font-size: .85rem; }
.location-pill { gap: 7px; padding: 8px 14px; color: var(--accent); background: var(--surface-soft); border: 1px solid var(--line); border-radius: 999px; font-size: .8rem; font-weight: 800; }
.dashboard-grid { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(300px, .85fr); gap: 30px; align-items: start; }
.main-column, .side-column, .workspace-card, .panel, .case-card, .resource-card, .form-grid > *, .inline-form > * { min-width: 0; }
.main-column { display: grid; gap: 28px; }
.side-column { display: grid; gap: 18px; }
.section-heading, .panel-heading { justify-content: space-between; gap: 10px; }
.section-heading { align-items: flex-end; margin-bottom: 14px; }
.section-heading h2, .panel-heading h2, .voice-panel h2 { margin: 5px 0 0; }
.service-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.service-card { position: relative; min-height: 160px; padding: 18px; text-align: left; border: 2px solid transparent; border-radius: 17px; transition: transform .2s, box-shadow .2s; }
.service-card:hover:not(:disabled) { transform: translateY(-2px); box-shadow: var(--shadow); }
.service-card-green { color: #0d5b50; background: #dff2ea; border-color: #b9dccd; }
.service-card-orange { color: #76501a; background: #fff0d7; border-color: #ead4a5; }
.service-card-blue { color: #245e80; background: #e1eff7; border-color: #bfd8e7; }
.service-card-purple { color: #665179; background: #eee8f4; border-color: #d8cbe5; }
.service-card-teal { color: #226d6c; background: #e0f2f1; border-color: #b9dad8; }
.service-card-rose { color: #8b4a45; background: #f8e9e4; border-color: #e7cbc2; }
.service-icon { display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 14px; border-radius: 12px; background: rgba(255, 255, 255, .7); font-weight: 900; }
.service-title { display: block; font-size: 1.1rem; font-weight: 900; }
.service-description { display: block; margin-top: 6px; color: #354f50; font-size: .8rem; }
.panel, .workspace-card { padding: 20px; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 7px 20px rgba(24, 54, 52, .04); }
.workspace-card + .workspace-card { margin-top: 16px; }
.workspace-heading { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; }
.workspace-heading h2, .workspace-heading h3 { margin: 5px 0 0; }
.demo-label, .tag, .status-chip { display: inline-flex; align-items: center; min-height: 32px; padding: 4px 9px; border-radius: 999px; font-size: .72rem; font-weight: 800; }
.demo-label, .tag { color: var(--accent); background: var(--mint); }
.status-chip.pending { color: #795015; background: #fff0c9; }
.status-chip.done { color: #27624f; background: #ddf1e7; }
.status-chip.returned { color: #8f3428; background: #fde7e1; }
.status-chip.active { color: #245e80; background: #e1eff7; }
.notification-count { display: grid; place-items: center; min-width: 34px; height: 34px; padding: 0 7px; color: #fff; border-radius: 999px; background: #b84d38; font-size: .8rem; font-weight: 900; }
.reminder-list { margin-top: 12px; }
.reminder-item { display: flex; align-items: center; width: 100%; gap: 10px; padding: 12px 0; text-align: left; background: transparent; border-bottom: 1px solid var(--line); }
.reminder-item strong, .reminder-item small { display: block; }
.reminder-item small { color: var(--muted); font-size: .75rem; }
.reminder-icon { display: grid; place-items: center; flex: 0 0 38px; width: 38px; height: 38px; color: #fff; border-radius: 10px; background: #b85a42; font-weight: 900; }
.panel-footer-button { width: 100%; margin-top: 8px; color: var(--accent); background: transparent; font-weight: 900; }
.family-avatar { display: grid; place-items: center; float: left; width: 48px; height: 48px; margin: 0 12px 8px 0; color: #75501d; border-radius: 50%; background: #efc881; font-weight: 900; }
.family-panel { background: #fdf7e8; }
.family-panel h2 { margin: 4px 0; }
.family-panel p { color: var(--muted); }
.family-actions { gap: 8px; clear: both; }
.voice-panel p { color: var(--muted); }
.listen-button { width: 100%; }
.voice-text-form { display: grid; gap: 10px; margin-top: 14px; }
.voice-text-form label { display: grid; gap: 6px; font-size: .85rem; font-weight: 800; }
.voice-note { font-size: .75rem; }
.voice-result { margin-top: 12px; padding: 10px; border-radius: 10px; background: var(--surface-soft); overflow-wrap: anywhere; }
.voice-result:empty { display: none; }
.case-list { display: grid; gap: 12px; }
.case-card { padding: 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface-soft); overflow-wrap: anywhere; }
.case-top { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
.case-top h3 { margin: 0; }
.case-meta { margin: 8px 0; color: var(--muted); }
.case-actions { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 10px; }
.case-card details, .workspace-card details { margin-top: 10px; }
summary { min-height: 60px; padding: 12px 4px; cursor: pointer; color: var(--accent); font-weight: 900; }
.history-list { padding-left: 22px; }
.history-list li { margin-bottom: 8px; }
.empty-state { padding: 14px 0; color: var(--muted); }
.notice, .policy-box, .integration-box, .affected-box { padding: 12px 14px; color: var(--muted); background: var(--surface-soft); border: 1px solid var(--line); border-radius: 12px; overflow-wrap: anywhere; }
.policy-box ul { margin-bottom: 0; padding-left: 22px; }
.warning-box { color: var(--danger); background: var(--danger-bg); border-color: var(--danger); }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 16px 0; }
.form-grid label, .stack-label, .inline-form label { display: grid; gap: 6px; color: var(--ink); font-size: .85rem; font-weight: 800; }
.full-field { grid-column: 1 / -1; }
input, select, textarea { width: 100%; max-width: 100%; min-height: 60px; padding: 9px 11px; color: var(--ink); background: var(--surface); border: 1px solid #aebfba; border-radius: 9px; }
textarea { min-height: 110px; resize: vertical; }
input[type="checkbox"], input[type="radio"] { width: 28px; min-width: 28px; height: 28px; min-height: 28px; padding: 0; accent-color: var(--accent); }
input[type="file"] { padding: 12px 8px; }
.check-row { display: flex !important; align-items: center; flex-direction: row; gap: 12px !important; min-height: 60px; padding: 10px 12px; color: var(--ink) !important; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; cursor: pointer; }
.check-row input { flex: none; }
.needs-options { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 0; padding: 12px; border: 1px solid var(--line); border-radius: 12px; }
.needs-options legend { padding: 0 8px; font-weight: 900; }
.modal-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
.modal-actions > * { flex: 1 1 160px; }
.inline-form { display: flex; align-items: end; flex-wrap: wrap; gap: 10px; margin: 12px 0; }
.inline-form > label { flex: 1 1 180px; }
.filter-bar { padding: 12px; background: var(--surface-soft); border: 1px solid var(--line); border-radius: 12px; }
.filter-bar > label { flex: 1 1 150px; }
.admin-section { margin-top: 18px; padding-top: 4px; border-top: 1px solid var(--line); }
.admin-section > summary { font-size: 1.05rem; }
.admin-case { border-left: 5px solid var(--accent); }
.batch-select { flex: none; }
.case-choice { display: flex; align-items: flex-start; gap: 8px; }
.admin-actions { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 10px; }
.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr)); gap: 10px; }
.stat-card { padding: 14px; background: var(--surface-soft); border: 1px solid var(--line); border-radius: 12px; }
.stat-card h3 { margin: 0 0 10px; }
.stat-row { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-bottom: 1px solid var(--line); }
.stat-row:last-child { border-bottom: 0; }
.stat-row strong { text-align: right; }
.recommendation-list, .resource-directory-list { display: grid; gap: 12px; }
.resource-card { display: flex; gap: 14px; padding: 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; }
.resource-visual { display: grid; place-items: center; flex: 0 0 82px; min-height: 100px; color: var(--accent); border-radius: 12px; background: var(--mint); font-size: 1.5rem; font-weight: 900; }
.resource-content { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.resource-content h3 { margin: 0 0 6px; }
.resource-content p { margin: 5px 0; color: var(--muted); }
.resource-actions { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 10px; }
.resource-map { position: relative; min-height: 230px; margin-top: 14px; overflow: hidden; border: 1px solid var(--line); border-radius: 16px; background: linear-gradient(35deg, rgba(219, 238, 231, .6) 25%, transparent 25%) 0 0 / 48px 48px, var(--surface); }
.map-label { position: absolute; z-index: 2; top: 10px; left: 12px; color: var(--muted); font-size: .75rem; font-weight: 900; }
.map-center, .map-point { position: absolute; z-index: 3; display: grid; place-items: center; transform: translate(-50%, -50%); border-radius: 50%; font-size: .7rem; font-weight: 900; }
.map-center { width: 58px; height: 58px; color: var(--on-accent); background: var(--accent); }
.map-point { width: 38px; height: 38px; color: var(--accent); background: var(--surface); border: 2px solid var(--accent); }
.resource-directory { margin-top: 14px; padding: 16px; background: var(--surface-soft); border: 1px solid var(--line); border-radius: 16px; }
.directory-heading { margin-top: 0; }
.evidence { display: block; width: min(240px, 100%); margin-top: 10px; border-radius: 10px; }
.integration-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr)); gap: 8px; padding: 0; list-style: none; }
.integration-list li { padding: 10px; background: var(--surface-soft); border: 1px solid var(--line); border-radius: 10px; }
.mode-code { display: block; margin-top: 4px; font-family: ui-monospace, monospace; font-size: .75rem; overflow-wrap: anywhere; }
.welfare-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 10px; }
.footer { width: min(1280px, calc(100% - 40px)); margin: 0 auto; padding: 24px 0 100px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; color: var(--muted); border-top: 1px solid var(--line); }
.floating-help { position: fixed; z-index: 6; right: 16px; bottom: 16px; min-width: 116px; color: var(--on-accent); background: var(--accent); border-radius: 15px; box-shadow: var(--shadow); font-size: 1.05rem; font-weight: 900; }
.toast { position: fixed; z-index: 40; left: 50%; bottom: 26px; width: max-content; max-width: calc(100% - 32px); padding: 14px 18px; color: #fff; background: #173238; border-radius: 12px; box-shadow: var(--shadow); opacity: 0; transform: translate(-50%, 15px); pointer-events: none; transition: .2s; overflow-wrap: anywhere; }
.toast.error { background: #8d2e22; }
.toast.show { opacity: 1; transform: translate(-50%, 0); }
.modal-backdrop { position: fixed; z-index: 30; inset: 0; display: grid; place-items: center; padding: 18px; background: rgba(15, 37, 35, .58); opacity: 0; visibility: hidden; transition: .18s; }
.modal-backdrop.open { opacity: 1; visibility: visible; }
.modal { position: relative; width: min(760px, 100%); max-height: calc(100dvh - 36px); padding: 28px; overflow-y: auto; overscroll-behavior: contain; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 20px; box-shadow: 0 24px 70px rgba(0, 0, 0, .24); }
.modal-close { position: sticky; z-index: 2; float: right; top: 0; width: 60px; min-width: 60px; height: 60px; margin: -12px -12px 0 0; color: var(--ink); background: var(--surface-soft); border: 1px solid var(--line); border-radius: 50%; font-size: 1.4rem; }
.modal h2 { margin: 0 60px 12px 0; }
.modal p { overflow-wrap: anywhere; }
.global-display-controls { width: min(1280px, calc(100% - 32px)); margin: 12px auto 0; padding: 10px; justify-content: flex-end; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; }
.access-screen { width: min(960px, calc(100% - 32px)); margin: clamp(20px, 5vh, 52px) auto; padding: clamp(20px, 4vw, 36px); background: var(--surface); border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--shadow); }
.access-screen h1 { margin: 16px 0 8px; }
.access-screen form, .access-screen label { display: grid; gap: 10px; }
.access-screen form { gap: 16px; max-width: 620px; margin: 22px auto 0; }
.access-screen h2 { margin-bottom: 0; }
.portal-picker { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 22px; }
.portal-card { min-width: 0; min-height: 176px; padding: 18px; text-align: left; color: var(--ink); background: var(--surface-soft); border: 2px solid var(--line); border-radius: 16px; }
.portal-card strong, .portal-card span { display: block; overflow-wrap: anywhere; }
.portal-card strong { margin-bottom: 10px; font-size: 1.15rem; }
.portal-card span { font-size: .85rem; }
.portal-card.active { color: var(--on-accent); background: var(--accent); border-color: var(--accent); box-shadow: var(--shadow); }
.resource-logic { color: var(--muted); font-size: .85rem; }
.account-list { display: grid; gap: 8px; padding: 0; list-style: none; }
.account-list li { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 10px; background: var(--surface-soft); border: 1px solid var(--line); border-radius: 10px; }
.audit-list { max-height: 520px; overflow-y: auto; }
.audit-list li { padding: 12px; background: var(--surface-soft); border: 1px solid var(--line); border-radius: 10px; }
body[data-theme="night"] { color-scheme: dark; --bg: #101a1c; --surface: #19282a; --surface-soft: #213436; --ink: #f0f8f5; --muted: #c2d6d3; --line: #66817c; --accent: #8ad8c3; --accent-dark: #a9e7d6; --on-accent: #082b25; --mint: #284a43; --warm: #3a3324; --warm-ink: #ffe4a8; --danger: #ffb0a1; --danger-bg: #462824; --focus: #ffd075; }
body[data-theme="contrast"] { color-scheme: light; --bg: #ffffff; --surface: #ffffff; --surface-soft: #ffffff; --ink: #000000; --muted: #111111; --line: #111111; --accent: #003f35; --accent-dark: #00251f; --on-accent: #ffffff; --mint: #e6fff6; --warm: #fff6cf; --warm-ink: #332300; --danger: #7d160d; --danger-bg: #fff1ed; --focus: #9a4b00; }
body:is([data-theme="night"], [data-theme="contrast"]) :is(.hero-section, .panel, .workspace-card, .service-card, .family-panel, .resource-card, .case-card, .control-group, .location-pill, .notice, .policy-box, .integration-box, .affected-box) { color: var(--ink); background: var(--surface); border-color: var(--line); }
body:is([data-theme="night"], [data-theme="contrast"]) :is(.eyebrow, .section-kicker, .hero-copy p, .service-description, .resource-content p, .family-avatar) { color: var(--ink); }
body:is([data-theme="night"], [data-theme="contrast"]) :is(.status-chip, .tag, .demo-label, .reminder-icon, .notification-count) { color: var(--ink); background: var(--mint); border: 1px solid var(--line); }
body[data-theme="contrast"] :is(.service-card, .panel, .workspace-card, .resource-card, .case-card, input, select, textarea) { border-width: 2px; }
@media (max-width: 1080px) {
  .dashboard-grid { grid-template-columns: minmax(0, 1fr); }
  .side-column { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .voice-panel { grid-column: 1 / -1; }
  .hero-illustration { opacity: .55; }
}
@media (max-width: 720px) {
  #main-content, .footer { width: calc(100% - 24px); }
  #main-content { padding-top: 18px; }
  .topbar { padding: 12px; }
  .display-controls { width: 100%; }
  .control-group { flex: 1 1 auto; }
  .accessibility-control { flex: 1 1 auto; }
  .hero-section { min-height: 0; padding: 24px 18px; }
  .hero-illustration { display: none; }
  .service-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .side-column { grid-template-columns: minmax(0, 1fr); }
  .voice-panel { grid-column: auto; }
  .form-grid, .portal-picker { grid-template-columns: minmax(0, 1fr); }
  .portal-card { min-height: 120px; }
  .global-display-controls { justify-content: stretch; }
  .full-field, .needs-options { grid-column: auto; }
  .resource-card { flex-direction: column; }
  .resource-visual { flex-basis: 60px; min-height: 60px; }
  .modal { padding: 22px 16px; }
  .modal h2 { margin-right: 52px; }
  .floating-help { right: 10px; bottom: 10px; }
}
@media (max-width: 480px) {
  .service-grid, .needs-options, .welfare-row { grid-template-columns: minmax(0, 1fr); }
  .primary-button, .secondary-button { width: 100%; }
  .speech-controls > * { flex: 1 1 100%; }
  .speech-controls label { display: grid; }
  .role-strip { align-items: flex-start; }
  .location-pill { border-radius: 12px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0s !important; }
}
